APP_NAME=Mock HRMS API
ENVIRONMENT=dev
APP_TIMEZONE=Asia/Kolkata
DATABASE_URL=sqlite+aiosqlite:///./storage/hrms.db
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMPLOYEE_DOCUMENT_UPLOAD_DIR=/app/storage/employee-documents

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# --- AI Copilot -------------------------------------------------------------
# Any OpenAI-compatible Chat Completions endpoint. Pick ONE block.
# Groq (free tier): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
# Google Gemini (free tier, key from https://aistudio.google.com/apikey). gemini-2.5-* is retired for new keys.
# Free-tier daily quotas are small (gemini-3.5-flash: 20 requests/day); the flash-lite models have their own quota.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash-lite
# Local Ollama (fully open source, no key needed; from Docker use http://host.docker.internal:11434/v1):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# Retries with back-off on rate limits / transient errors
LLM_MAX_RETRIES=3

# HR action agent: empty = call the existing API in-process (recommended); or a base URL such as http://localhost:8000
AI_INTERNAL_API_BASE_URL=
AI_MAX_TOOL_STEPS=5
AI_CONFIRMATION_TTL_SECONDS=600

# SQL agent: maximum rows returned and query time limit
SQL_MAX_ROWS=100
SQL_TIMEOUT_SECONDS=5

# Embeddings run locally. "fastembed" downloads a small open-source model on first start.
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Minimum similarity for a policy chunk to count as relevant (leave unset for the default)
# RAG_MIN_SCORE=0.55
